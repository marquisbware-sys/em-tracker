// @version=6
// Expected Move + 0.16 Delta (Compact) - Pine v6
// Plots EM bands AND 0.16 delta strike bands.
//
// String format:
//   TICKER:WEEKLY_EM:MONTHLY_EM:PRICE:W_D16_CALL:W_D16_PUT:M_D16_CALL:M_D16_PUT
//   Example: SPY:7.78:19.29:756.48:765.5:746.2:780.0:730.5,QQQ:...
//
// Backwards compatible: 4-field rows still work, delta section just skipped.

indicator("Expected Move + Δ16 (Compact)", overlay = true, max_lines_count = 30, max_labels_count = 30)

// ============================================================
// USER INPUTS
// ============================================================
string emString = input.text_area(defval = "SPY:7.78:19.29:756.48:765.5:746.2:780.0:730.5,QQQ:12.47:29.76:738.31:758.0:715.5:780.0:690.0", title = "EM Watchlist String", tooltip = "Format: TICKER:wEM:mEM:price:wD16C:wD16P:mD16C:mD16P separated by commas.")

bool showWeekly      = input.bool(true, "Show Weekly EM Bands",   group = "EM Bands")
bool showMonthly     = input.bool(true, "Show Monthly EM Bands",  group = "EM Bands")
bool showMidline     = input.bool(true, "Show Reference Price Line", group = "EM Bands")
color weeklyColor    = input.color(color.lime,   "Weekly EM Color",   group = "EM Bands")
color monthlyColor   = input.color(color.orange, "Monthly EM Color",  group = "EM Bands")
color midColor       = input.color(color.gray,   "Reference Line Color", group = "EM Bands")

bool showWeeklyD16   = input.bool(true, "Show Weekly 0.16Δ Bands",  group = "0.16 Delta Bands")
bool showMonthlyD16  = input.bool(true, "Show Monthly 0.16Δ Bands", group = "0.16 Delta Bands")
color weeklyD16Color  = input.color(color.aqua,    "Weekly Δ16 Color",  group = "0.16 Delta Bands")
color monthlyD16Color = input.color(color.fuchsia, "Monthly Δ16 Color", group = "0.16 Delta Bands")

bool showTable       = input.bool(true, "Show Info Table",     group = "Display")
int  bandWidth       = input.int(2, "Band Line Width", minval = 1, maxval = 5, group = "Display")
bool extendBands     = input.bool(true, "Extend Bands Forward", group = "Display")

// ============================================================
// PARSE WATCHLIST
// Returns 7-tuple: [wEM, mEM, refP, wD16C, wD16P, mD16C, mD16P]
// ============================================================
parseEM(string fullString, string currentTicker) =>
    float wEM   = na
    float mEM   = na
    float refP  = na
    float wD16C = na
    float wD16P = na
    float mD16C = na
    float mD16P = na

    array<string> entries = str.split(fullString, ",")
    int numEntries = array.size(entries)
    bool found = false

    for i = 0 to numEntries - 1
        if not found
            string entry = str.trim(array.get(entries, i))
            array<string> parts = str.split(entry, ":")
            int sz = array.size(parts)

            if sz >= 4
                string tickerName = str.trim(array.get(parts, 0))
                if str.upper(tickerName) == str.upper(currentTicker)
                    wEM  := str.tonumber(array.get(parts, 1))
                    mEM  := str.tonumber(array.get(parts, 2))
                    refP := str.tonumber(array.get(parts, 3))
                    if sz >= 5
                        wD16C := str.tonumber(array.get(parts, 4))
                    if sz >= 6
                        wD16P := str.tonumber(array.get(parts, 5))
                    if sz >= 7
                        mD16C := str.tonumber(array.get(parts, 6))
                    if sz >= 8
                        mD16P := str.tonumber(array.get(parts, 7))
                    found := true

    [wEM, mEM, refP, wD16C, wD16P, mD16C, mD16P]

[weeklyEM, monthlyEM, refPrice, wD16Call, wD16Put, mD16Call, mD16Put] = parseEM(emString, syminfo.ticker)

// ============================================================
// WEEK BOUNDARIES
// ============================================================
int msPerDay        = 86400000
int daysSinceMonday = (dayofweek(time) + 5) % 7
int mondayStart     = time - daysSinceMonday * msPerDay
int fridayEnd       = mondayStart + 5 * msPerDay
int monthEnd        = mondayStart + 30 * msPerDay

int weeklyRight  = extendBands ? fridayEnd : time
int monthlyRight = extendBands ? monthEnd  : time

// ============================================================
// LINE/LABEL MANAGEMENT
// ============================================================
var array<line>  activeLines  = array.new<line>()
var array<label> activeLabels = array.new<label>()

clearAll() =>
    if array.size(activeLines) > 0
        for i = 0 to array.size(activeLines) - 1
            line.delete(array.get(activeLines, i))
    if array.size(activeLabels) > 0
        for i = 0 to array.size(activeLabels) - 1
            label.delete(array.get(activeLabels, i))
    array.clear(activeLines)
    array.clear(activeLabels)

drawHLine(int leftT, int rightT, float price, color c, int width, string styleName) =>
    string ls = styleName == "solid"  ? line.style_solid  : styleName == "dashed" ? line.style_dashed : line.style_dotted
    line ln = line.new(leftT, price, rightT, price, xloc = xloc.bar_time, color = c, width = width, style = ls)
    array.push(activeLines, ln)

drawLabel(int t, float price, string txt, color c) =>
    label lbl = label.new(t, price, text = txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 80), textcolor = c, size = size.small)
    array.push(activeLabels, lbl)

// ============================================================
// MAIN DRAW
// ============================================================
if barstate.islast and not na(refPrice)
    clearAll()

    if showMidline
        drawHLine(mondayStart, weeklyRight, refPrice, color.new(midColor, 30), 1, "dashed")

    // Weekly EM (solid)
    if showWeekly and not na(weeklyEM)
        drawHLine(mondayStart, weeklyRight, refPrice + weeklyEM, weeklyColor, bandWidth, "solid")
        drawHLine(mondayStart, weeklyRight, refPrice - weeklyEM, weeklyColor, bandWidth, "solid")
        drawLabel(weeklyRight, refPrice + weeklyEM, "W EM +" + str.tostring(weeklyEM, "#.##"), weeklyColor)
        drawLabel(weeklyRight, refPrice - weeklyEM, "W EM -" + str.tostring(weeklyEM, "#.##"), weeklyColor)

    // Monthly EM (dotted)
    if showMonthly and not na(monthlyEM)
        drawHLine(mondayStart, monthlyRight, refPrice + monthlyEM, monthlyColor, bandWidth, "dotted")
        drawHLine(mondayStart, monthlyRight, refPrice - monthlyEM, monthlyColor, bandWidth, "dotted")
        drawLabel(monthlyRight, refPrice + monthlyEM, "M EM +" + str.tostring(monthlyEM, "#.##"), monthlyColor)
        drawLabel(monthlyRight, refPrice - monthlyEM, "M EM -" + str.tostring(monthlyEM, "#.##"), monthlyColor)

    // Weekly Δ16 (dashed)
    if showWeeklyD16
        if not na(wD16Call)
            drawHLine(mondayStart, weeklyRight, wD16Call, weeklyD16Color, bandWidth, "dashed")
            drawLabel(weeklyRight, wD16Call, "W Δ16C " + str.tostring(wD16Call, "#.##"), weeklyD16Color)
        if not na(wD16Put)
            drawHLine(mondayStart, weeklyRight, wD16Put, weeklyD16Color, bandWidth, "dashed")
            drawLabel(weeklyRight, wD16Put, "W Δ16P " + str.tostring(wD16Put, "#.##"), weeklyD16Color)

    // Monthly Δ16 (dashed)
    if showMonthlyD16
        if not na(mD16Call)
            drawHLine(mondayStart, monthlyRight, mD16Call, monthlyD16Color, bandWidth, "dashed")
            drawLabel(monthlyRight, mD16Call, "M Δ16C " + str.tostring(mD16Call, "#.##"), monthlyD16Color)
        if not na(mD16Put)
            drawHLine(mondayStart, monthlyRight, mD16Put, monthlyD16Color, bandWidth, "dashed")
            drawLabel(monthlyRight, mD16Put, "M Δ16P " + str.tostring(mD16Put, "#.##"), monthlyD16Color)

// ============================================================
// INFO TABLE
// ============================================================
var table infoPanel = table.new(position = position.top_right, columns = 2, rows = 9, frame_color = color.gray, frame_width = 1, border_color = color.gray, border_width = 1, bgcolor = color.new(color.black, 70))

if barstate.islast and showTable
    if not na(weeklyEM) and not na(refPrice)
        float priceVsRef  = math.abs(close - refPrice)
        float pctOfWeekly = priceVsRef / weeklyEM * 100
        color rangeColor  = pctOfWeekly < 50 ? color.green : pctOfWeekly < 80 ? color.yellow : pctOfWeekly < 100 ? color.orange : color.red

        table.cell(infoPanel, 0, 0, syminfo.ticker, text_color = color.white, text_size = size.normal, bgcolor = color.new(color.blue, 80))
        table.cell(infoPanel, 1, 0, "$" + str.tostring(close, "#.##"), text_color = color.white, text_size = size.normal, bgcolor = color.new(color.blue, 80))

        table.cell(infoPanel, 0, 1, "Ref Price", text_color = color.gray, text_size = size.small)
        table.cell(infoPanel, 1, 1, "$" + str.tostring(refPrice, "#.##"), text_color = color.gray, text_size = size.small)

        table.cell(infoPanel, 0, 2, "Weekly EM", text_color = weeklyColor, text_size = size.small)
        table.cell(infoPanel, 1, 2, "±$" + str.tostring(weeklyEM, "#.##"), text_color = weeklyColor, text_size = size.small)

        table.cell(infoPanel, 0, 3, "W EM Range", text_color = weeklyColor, text_size = size.small)
        table.cell(infoPanel, 1, 3, str.tostring(refPrice - weeklyEM, "#.##") + " / " + str.tostring(refPrice + weeklyEM, "#.##"), text_color = weeklyColor, text_size = size.small)

        if not na(wD16Put) and not na(wD16Call)
            table.cell(infoPanel, 0, 4, "W Δ16 Range", text_color = weeklyD16Color, text_size = size.small)
            table.cell(infoPanel, 1, 4, str.tostring(wD16Put, "#.##") + " / " + str.tostring(wD16Call, "#.##"), text_color = weeklyD16Color, text_size = size.small)

        if not na(monthlyEM)
            table.cell(infoPanel, 0, 5, "Monthly EM", text_color = monthlyColor, text_size = size.small)
            table.cell(infoPanel, 1, 5, "±$" + str.tostring(monthlyEM, "#.##"), text_color = monthlyColor, text_size = size.small)

            table.cell(infoPanel, 0, 6, "M EM Range", text_color = monthlyColor, text_size = size.small)
            table.cell(infoPanel, 1, 6, str.tostring(refPrice - monthlyEM, "#.##") + " / " + str.tostring(refPrice + monthlyEM, "#.##"), text_color = monthlyColor, text_size = size.small)

        if not na(mD16Put) and not na(mD16Call)
            table.cell(infoPanel, 0, 7, "M Δ16 Range", text_color = monthlyD16Color, text_size = size.small)
            table.cell(infoPanel, 1, 7, str.tostring(mD16Put, "#.##") + " / " + str.tostring(mD16Call, "#.##"), text_color = monthlyD16Color, text_size = size.small)

        table.cell(infoPanel, 0, 8, "% of W EM", text_color = color.gray, text_size = size.small)
        table.cell(infoPanel, 1, 8, str.tostring(pctOfWeekly, "#.#") + "%", text_color = rangeColor, text_size = size.small)
    else
        table.cell(infoPanel, 0, 0, syminfo.ticker, text_color = color.yellow, text_size = size.normal)
        table.cell(infoPanel, 1, 0, "Not in string", text_color = color.yellow, text_size = size.small)

// ============================================================
// ALERTS
// ============================================================
bool emUpperBreak = not na(weeklyEM) and not na(refPrice) and ta.crossover(close, refPrice + weeklyEM)
bool emLowerBreak = not na(weeklyEM) and not na(refPrice) and ta.crossunder(close, refPrice - weeklyEM)
bool d16CallTouch = not na(wD16Call) and ta.crossover(close, wD16Call)
bool d16PutTouch  = not na(wD16Put)  and ta.crossunder(close, wD16Put)

alertcondition(emUpperBreak, "Weekly EM Upper Break", "Price broke weekly EM upper band")
alertcondition(emLowerBreak, "Weekly EM Lower Break", "Price broke weekly EM lower band")
alertcondition(d16CallTouch, "Weekly Δ16 Call Touch", "Price touched weekly 0.16Δ call strike")
alertcondition(d16PutTouch,  "Weekly Δ16 Put Touch",  "Price touched weekly 0.16Δ put strike")
